{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modfig.dev/spec/proof-record.schema.json",
  "title": "ModFig Capability Proof Record",
  "description": "Sanitized runtime evidence. Client adapters may not advertise support without a record validated against this contract and the capability matrix.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proofVersion",
    "rowId",
    "identity",
    "paths",
    "credentialMechanism",
    "processCheck",
    "harnessVersion",
    "revisions",
    "fixture",
    "procedure",
    "startedAt",
    "completedAt",
    "validUntil",
    "results",
    "sanitization"
  ],
  "properties": {
    "proofVersion": {"type": "integer", "const": 1},
    "rowId": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathIdentity"}},
    "credentialMechanism": {"type": "string", "minLength": 1},
    "processCheck": {"$ref": "#/$defs/processCheck"},
    "harnessVersion": {"type": "string", "minLength": 1},
    "revisions": {"$ref": "#/$defs/revisions"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "procedure": {"$ref": "#/$defs/procedure"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "results": {"$ref": "#/$defs/results"},
    "sanitization": {"$ref": "#/$defs/sanitization"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalClient", "component", "adapterId", "featureKey", "os", "surface", "channel", "profileMode", "client", "owner"],
      "properties": {
        "logicalClient": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "component": {"$ref": "#/$defs/component"},
        "adapterId": {"type": "string", "minLength": 1},
        "featureKey": {"type": "string", "minLength": 1},
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "build"],
          "properties": {
            "family": {"enum": ["macos", "linux", "windows"]},
            "build": {"type": "string", "minLength": 1}
          }
        },
        "surface": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "profileMode": {"type": "string", "minLength": 1},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "build", "executablePath", "executableSha256", "userDataIdentity"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "build": {"type": "string", "minLength": 1},
            "executablePath": {"type": "string", "minLength": 1},
            "executableSha256": {"$ref": "#/$defs/sha256"},
            "userDataIdentity": {"$ref": "#/$defs/sha256"}
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identityHash"],
          "properties": {
            "kind": {"enum": ["uid", "sid"]},
            "identityHash": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "component": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "core"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "extension"},
            "name": {
              "type": "string",
              "pattern": "^(?!core$)[a-z][a-z0-9-]*$"
            }
          }
        }
      ]
    },
    "pathIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "identityHash"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "identityHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "processCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectorId", "quiescent", "executables"],
      "properties": {
        "detectorId": {"type": "string", "minLength": 1},
        "quiescent": {"type": "boolean"},
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "spec", "artifact"],
      "properties": {
        "adapter": {"$ref": "#/$defs/sha256"},
        "spec": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^spec/fixtures/proof/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticatedRequest", "restartReload", "foreignStatePreservation", "recovery", "secretScan"],
      "properties": {
        "authenticatedRequest": {"$ref": "#/$defs/result"},
        "restartReload": {"$ref": "#/$defs/result"},
        "foreignStatePreservation": {"$ref": "#/$defs/result"},
        "recovery": {"$ref": "#/$defs/result"},
        "secretScan": {"$ref": "#/$defs/result"}
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsCredentialValues", "containsEnvironment", "containsFullArgv", "containsRawClientState"],
      "properties": {
        "containsCredentialValues": {"const": false},
        "containsEnvironment": {"const": false},
        "containsFullArgv": {"const": false},
        "containsRawClientState": {"const": false}
      }
    }
  }
}
